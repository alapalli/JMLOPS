# ─────────────────────────────────────────────────────────────
# JML Ops · Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development               # development | production
LOG_LEVEL=debug                    # debug | info | warn | error
APP_VERSION=0.1.0

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=jmlops
DATABASE_URL=postgresql://dev:dev@localhost:5432/jmlops

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ── SSO Login (Google & Microsoft) ────────────────────────────
# These are for USER LOGIN to JML Ops itself (via OAuth2 "Sign in
# with Google/Microsoft") — NOT the same credentials as the Google
# Workspace or Entra ID CONNECTORS further below, which use service
# accounts to provision employees. Do not reuse credentials between
# these two purposes even though both involve Google/Microsoft.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create OAuth client ID -> Web application
#   Authorized redirect URI: {API_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: portal.azure.com -> Microsoft Entra ID -> App registrations
#   -> New registration -> Web platform
#   Redirect URI: {API_ORIGIN}/auth/microsoft/callback
#   API permissions needed: openid, profile, email, User.Read (delegated)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Used to build OAuth callback/redirect URLs — set these to your real
# domains in production (e.g. https://app.jml-ops.com, https://api.jml-ops.com)
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# ── Demo mode (conference/booth use ONLY) ────────────────────
# Adds a "Try the demo — no account needed" button to the login page,
# issuing a real session for a single, fixed, isolated demo user — no
# passwords, reuses the existing SSO session mechanism entirely.
# Leave unset (or "false") for any real customer deployment. Only ever
# set to "true" on a deliberately conference-scoped instance.
DEMO_MODE_ENABLED=false

# ── LiteLLM ──────────────────────────────────────────────────
LITELLM_URL=http://localhost:4002
# Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-dev-CHANGE_ME

# ── Anthropic (Claude API) ───────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ── Ollama (local AI) ─────────────────────────────────────────
# DEV: runs natively on your machine, not in Docker — the value
#   below (host.docker.internal) only resolves in local Docker
#   Desktop setups.
# PROD: this file is also used as the .env.prod template — if
#   you're deploying, you MUST replace this with your GPU host's
#   real address (private IP or domain). host.docker.internal
#   will NOT work on a real server and local model routing will
#   silently fail over to Claude fallbacks instead.
#   See infra/prod/GPU_HOST_SETUP.md for provisioning that server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Models to pull on setup:
# mistral, qwen2.5:27b, deepseek-r1:14b, nomic-embed-text

# ── API Server ───────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=JML Ops

# ── Worker ───────────────────────────────────────────────────
WORKER_CONCURRENCY=4
ENABLE_SCIM=false                  # set true when first integration is ready

# ── Email (Resend) ───────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=JML Ops

# Dev: mailpit catches all outgoing emails → http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Integrations (leave blank until needed) ──────────────────

# Okta
OKTA_DOMAIN=
OKTA_API_TOKEN=
OKTA_SCIM_TOKEN=

# Microsoft Entra ID
# NOTE: sign in via SSO first (creates your company automatically), then
# set SEED_COMPANY_DOMAIN below to that email's domain before running
# `pnpm db:seed` — this activates the connector for your real company,
# not a fake pre-seeded one. See packages/db/src/seed.ts for detail.
SEED_COMPANY_DOMAIN=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SCIM_TOKEN=

# Google Workspace
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CUSTOMER_ID=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# GitHub Enterprise
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_ORG=

# Jira Service Management
JSM_BASE_URL=
JSM_EMAIL=
JSM_API_TOKEN=
JSM_ONBOARDING_PROJECT_KEY=IT
JSM_OFFBOARDING_PROJECT_KEY=IT

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# SAP Cloud Identity Services
SAP_CIS_URL=
SAP_CIS_CLIENT_ID=
SAP_CIS_CLIENT_SECRET=

# Azure Sentinel (DCR Logs Ingestion)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENTINEL_DCR_ENDPOINT=
SENTINEL_DCR_RULE_ID=
SENTINEL_DCR_STREAM_NAME=Custom-JML_LifecycleEvents_CL

# WhatsApp (WATI)
WATI_API_URL=
WATI_API_TOKEN=

# ── Security ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
AUDIT_HMAC_SECRET=CHANGE_ME_openssl_rand_hex_32
WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Feature Flags ────────────────────────────────────────────
ENABLE_SENTINEL=false
ENABLE_WHATSAPP=false
ENABLE_SOC2_EXPORT=false
