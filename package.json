{
  "name": "jmlops",
  "private": true,
  "version": "0.1.0",
  "description": "JML Ops — AI-powered employee lifecycle automation",
  "scripts": {
    "dev":           "turbo run dev --parallel",
    "build":         "turbo run build",
    "test":          "turbo run test",
    "lint":          "turbo run lint",
    "typecheck":     "turbo run typecheck",
    "db:generate":   "turbo run db:generate",
    "db:migrate":    "pnpm --filter @jml-ops/db migrate:dev",
    "db:migrate:prod":"pnpm --filter @jml-ops/db migrate:deploy",
    "db:seed":       "pnpm --filter @jml-ops/db seed",
    "db:studio":     "pnpm --filter @jml-ops/db studio",
    "db:reset":      "pnpm --filter @jml-ops/db migrate:reset",
    "infra:up":      "docker compose -f infra/dev/docker-compose.yml up -d",
    "infra:down":    "docker compose -f infra/dev/docker-compose.yml down",
    "infra:logs":    "docker compose -f infra/dev/docker-compose.yml logs -f",
    "infra:reset":   "docker compose -f infra/dev/docker-compose.yml down -v && pnpm infra:up",
    "setup":         "node infra/scripts/setup.mjs"
  },
  "devDependencies": {
    "turbo":           "^2.3.0",
    "@types/node":     "^22.0.0",
    "typescript":      "^5.6.0",
    "eslint":          "^9.0.0",
    "prettier":        "^3.3.0",
    "lint-staged":     "^15.2.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
